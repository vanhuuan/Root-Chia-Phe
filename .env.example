# Copy to .env; replace all placeholders locally. Never commit .env.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
POSTGRES_USER=root_local
POSTGRES_DB=root_chia_phe
POSTGRES_PORT=5433
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
# URL-encode the password in this URL (or use a random hexadecimal password).
DATABASE_URL=postgresql://root_local:REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD@127.0.0.1:5433/root_chia_phe?sslmode=disable
# Only needed for docker compose --profile app (use the SAME encoded password):
CONTAINER_DATABASE_URL=postgresql://root_local:REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD@postgres:5432/root_chia_phe?sslmode=disable
# Azure: postgresql://USER:URL_ENCODED_PASSWORD@SERVER.postgres.database.azure.com:5432/root_chia_phe?sslmode=verify-full
